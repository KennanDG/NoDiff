{
  "name": "coding-agent-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "desktop:dev": "vite",
    "backend:build:windows": "cd ../backend && uv run pyinstaller --noconfirm --clean nodiff-agent-runtime.spec",
    "desktop:build": "npm run desktop:build:windows",
    "desktop:build:windows": "npm run backend:build:windows && npm run build && electron-builder --win nsis --x64",
    "desktop:build:store": "npm run backend:build:windows && npm run build && electron-builder --config electron-builder.store.cjs --win msix --x64"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.515.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vitest": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.10",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "com.kennangauthier.nodiff",
    "productName": "NoDiff",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/nodiff-agent-runtime",
        "to": "backend/nodiff-agent-runtime"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.svg",
      "executableName": "NoDiff"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NoDiff",
      "artifactName": "NoDiff-${version}-${arch}-Setup.${ext}"
    }
  }
}
